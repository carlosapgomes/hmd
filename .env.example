# ---------------------------------------------------------------------------
# HMD — Hemodinâmica — variáveis de ambiente
# ---------------------------------------------------------------------------
# Copie para .env e ajuste:  cp .env.example .env
#
# Nenhuma variável é obrigatória em desenvolvimento (existem defaults
# explícitos em config/settings/dev.py e config/settings/test.py).
# Em produção (config.settings.prod) o sistema falha fechado:
# DJANGO_SECRET_KEY e credenciais de banco são obrigatórias.
# ---------------------------------------------------------------------------

# Django
# ---------------------------------------------------------------------------
# Chave secreta. Em dev há default explícito de desenvolvimento; em prod a
# ausência aborta a inicialização com ImproperlyConfigured (nunca usar o
# default de dev em produção).
DJANGO_SECRET_KEY=dev-secret-key-not-for-production

# Debug (dev default: true). Produção ignora a variável e roda sempre com
# DEBUG=false.
DJANGO_DEBUG=true

# Hosts permitidos em produção, separados por vírgula (dev aceita qualquer
# host via ALLOWED_HOSTS=["*"]). Ex.: ALLOWED_HOSTS=hmd.example.com
ALLOWED_HOSTS=

# Nome do app exibido na UI (navbar/título/meta tags)
APP_DISPLAY_NAME=HMD — Hemodinâmica

# Banco de dados — desenvolvimento (PostgreSQL 17)
# ---------------------------------------------------------------------------
# DATABASE_URL tem precedência sobre as variáveis individuais DB_* abaixo
# (config/settings/db.py resolve a configuração em ordem: DATABASE_URL →
# DB_* → DB_PASSWORD_FILE → defaults de dev). Sem URL e sem senha
# disponível a inicialização aborta com ImproperlyConfigured — o HMD falha
# fechado, nunca retorna configuração vazia silenciosamente.
DATABASE_URL=postgres://hmd:hmd_dev@localhost:5432/hmd_dev

# Porta host do Postgres do compose dev (`docker compose up -d db`). Ajuste
# junto com DATABASE_URL para evitar conflito com outro PostgreSQL no host;
# config/settings/dev.py lê a mesma variável para o default local.
POSTGRES_HOST_PORT=5432

# Montagem por variáveis individuais — usadas quando DATABASE_URL está ausente.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hmd_dev
DB_USER=hmd
DB_PASSWORD=hmd_dev
# Arquivo com a senha (Docker secret/K8s). Se definido, tem precedência sobre
# DB_PASSWORD; o arquivo deve existir, ser legível e não estar vazio.
DB_PASSWORD_FILE=
# Nome da aplicação reportado ao Postgres (OPTIONS.application_name).
#DB_APPLICATION_NAME=hmd

# Banco de dados — teste (suíte pytest)
# ---------------------------------------------------------------------------
# A suíte roda com config.settings.test, que resolve APENAS TEST_DATABASE_URL/
# TEST_DB_* e nunca toca o banco de desenvolvimento, mesmo com .env carregado.
# Por isso DATABASE_URL/DB_* acima não afetam os testes.
TEST_DATABASE_URL=postgres://hmd:hmd_dev@localhost:5433/hmd_test

# Porta host do Postgres efêmero do compose de teste
# (`docker compose -f docker-compose.test.yml up -d`) e porta default das
# settings de teste. Ajuste as duas juntas se 5433 estiver ocupada.
TEST_DB_PORT=5433

# Variáveis individuais de teste — usadas quando TEST_DATABASE_URL está
# ausente (nunca definidas em conjunto com TEST_DATABASE_URL apontando para
# outro banco).
TEST_DB_HOST=localhost
TEST_DB_NAME=hmd_test
TEST_DB_USER=hmd
TEST_DB_PASSWORD=hmd_dev

# Deploy produtivo do piloto — docker-compose.prod.yml (change
# pilot-deployment-v0-1-1, slice 003)
# ---------------------------------------------------------------------------
# O compose produtivo referencia TUDO por ${VAR}: os valores reais (senhas,
# AD_DCS, INTRANET_IP_RANGE) ficam apenas no .env do host, nunca no Git. As
# linhas abaixo existem para o operador saber QUAIS nomes existem — só as
# marcadas como comentadas têm default no compose/settings.
#
# Imagem publicada no GHCR (release v*): fixe SEMPRE tag+digest no .env do host
# (`HMD_IMAGE_TAG=v0.1.9@sha256:73b11509e15ac64047c8af82384f0760c31ee17780b993c432d394e4ade76231`) — a tag sozinha é mutável. Default
# do compose: v0.1.6 (deixe comentado para acompanhar o default).
#HMD_IMAGE_TAG=v0.1.9@sha256:73b11509e15ac64047c8af82384f0760c31ee17780b993c432d394e4ade76231
# Banco por componentes: o compose produtivo NÃO usa mais URL de banco (só
# DB_*). Os nomes DB_HOST/DB_PORT/DB_NAME/DB_USER são os mesmos documentados na
# seção de desenvolvimento acima; no host do piloto valem DB_HOST = alias do PG
# compartilhado (postgres-app-hmd / hmd), DB_NAME = app_hmd e DB_USER = role da
# APLICAÇÃO (DML nas tabelas do schema, incluindo hmd_cache).
DB_HOST=
DB_PORT=5432
DB_NAME=app_hmd
DB_USER=
# Role de MIGRATOR (DDL) — usada APENAS pelo passo one-shot `migrate`.
MIGRATOR_DB_USER=
#
# Segredos por ARQUIVO (Docker secret / arquivo read-only no host): só o
# CAMINHO entra no Git. O arquivo tem uma senha por linha, PRECEDE qualquer env
# equivalente e falha fechado se ilegível/vazio. Os arquivos default ficam em
# ./secrets/ (fora do Git — ver .gitignore) ou em qualquer caminho do host.
APP_DB_PASSWORD_FILE=
MIGRATOR_DB_PASSWORD_FILE=
SECRET_KEY_FILE=
SUPERUSER_PASSWORD_FILE=
# Origens confiáveis do CSRF, separadas por vírgula. O default de produção já
# é a URL pública do piloto; ajuste se o DNS mudar (só https, sem barra final).
CSRF_TRUSTED_ORIGINS=https://hmd.projetoshgrs.com
# TLS termina no proxy reverso (Caddy), que injeta X-Forwarded-Proto: true
# (default do piloto) liga SECURE_PROXY_SSL_HEADER; false desliga quando não
# houver proxy HTTPS à frente.
PROXY_SSL_HEADER=true
# Username do superusuário local criado pelo `seed_admin` no passo migrate
# (env não-sensível); a SENHA vem do arquivo SUPERUSER_PASSWORD_FILE acima (o
# comando segue aceitando DJANGO_SUPERUSER_PASSWORD por env para uso local).
DJANGO_SUPERUSER_USERNAME=

# Intranet guard (ADR-0002) — restrição do papel `nir` à rede interna
# ---------------------------------------------------------------------------
# Papéis restritos à rede interna, separados por vírgula. O bloqueio externo
# vale apenas para usuários cujo conjunto de papéis é EXCLUSIVAMENTE restrito
# (ex.: apenas `nir`); quem tem qualquer papel fora do conjunto acessa de
# qualquer rede mesmo com papel ativo restrito (revisão 2026-09-13 do
# ADR-0002). Default: apenas `nir` (scheduler acessa via internet — unidade 2).
INTRANET_RESTRICTED_ROLES=nir
# Faixas de intranet em CIDR, separadas por vírgula (ex.: 10.0.0.0/8,
# 192.168.15.0/24). VAZIO = restrição desligada (default de desenvolvimento).
INTRANET_IP_RANGE=
# Header de proxy reverso com o IP real do cliente. Piloto
# (Cloudflared → Caddy → HMD): deixe comentado — o compose aplica
# HTTP_CF_CONNECTING_IP por default (borda Cloudflare fixa o header com o
# cliente real; o Caddy repassa sem tocar — NÃO usar header_up
# X-Forwarded-For {remote_host} nesse hop). XFF+header_up só em Caddy-direto.
#TRUSTED_PROXY_HEADER=HTTP_X_FORWARDED_FOR  # exemplo APENAS p/ Caddy-direto

# Rótulos das unidades de agendamento — change unit-labels-env
# ---------------------------------------------------------------------------
# Nomes exibidos para a unidade 1 (local) e a unidade 2 (internet) em todo o
# produto, incluindo a resposta final ao NIR da unidade 2. Vazio → default
# "Unidade 1"/"Unidade 2" (o rótulo é exibido como fornecido, com strip).
HMD_UNIT_1_LABEL=Unidade 1
HMD_UNIT_2_LABEL=Unidade 2

# Notificações in-app (change dashboard-notifications-pwa, slice 002) — janela
# de retenção, em horas, das notificações JÁ LIDAS na lista (default 48). As
# não lidas nunca somem e nada é apagado: a leitura fora da janela só sai do
# resultado da lista.
NOTIFICATION_READ_RETENTION_HOURS=48

# Autenticação AD (Kerberos) — change ad-kerberos-authentication
# ---------------------------------------------------------------------------
# DCs (KDCs) do domínio raiz, separados por vírgula. O realm de autenticação
# NÃO é configurável aqui: é derivado do sufixo do ad_upn do usuário no
# momento da validação (floresta multi-domínio). SEM default: provisionar os
# endereços reais no ambiente de cada deploy (vazio ⇒ login AD indisponível
# por config, fail-closed nomeado).
AD_DCS=
# Timeout por tentativa Kerberos, em segundos (default: 3).
AD_KDC_TIMEOUT=3

# Proteção anti-lockout local (slice 004): limite de tentativas de login
# malsucedidas por CPF/IP+CPF e duração do bloqueio temporário, no cache do
# Django. Defaults (5/900s/900s) abaixo da política típica de lockout do AD.
# Em produção o cache PRECISA ser compartilhado entre workers (Redis/
# Memcached): config.settings.prod falha fechado (ImproperlyConfigured)
# enquanto CACHES for o LocMem de dev/teste.
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_ATTEMPTS_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Locks de casos (change 03, slice 004) — duração default da lease de
# exclusividade de mutação por caso, em segundos (default: 300 = 5min).
CASE_LOCK_LEASE_SECONDS=300

# Intake do relatório NIR em LOTE (change intake-batch-semantics, slice 002) —
# cada PDF é o relatório de UM paciente e vira UM caso; o tipo de procedimento
# é único por envio. Limites do envio: arquivos por lote (30), bytes por
# arquivo (20971520 = 20 MB) e bytes no total do lote (104857600 = 100 MB).
# NOTA operacional: os 100 MB do lote são o limite prático do request body no
# túnel Cloudflare do piloto (~100 MB no plano free) — suba só se o caminho de
# entrada mudar. O compose produtivo repassa as 3 com ${VAR:-default}.
INTAKE_MAX_FILES_PER_BATCH=30
INTAKE_MAX_UPLOAD_BYTES_PER_FILE=20971520
INTAKE_MAX_UPLOAD_BYTES_PER_BATCH=104857600

# Gate de regulação (change intake-nir-upload, slice 002) — thresholds do
# padrão SESAB: tamanho mínimo do texto extraído (chars) e nº mínimo de seções
# operacionais do relatório para não ser retido.
INTAKE_REGULATION_MIN_TEXT_CHARS=500
INTAKE_REGULATION_MIN_OPERATIONAL_SECTIONS=3

# Processamento do intake (change intake-nir-upload, slice 003) — modo de
# execução da task de extração pós-criação: true (default dev/teste) roda a
# task sincronamente na criação (sem worker, UX imediata); false enfileira no
# cluster pdf do django-q2. Produção força false se não definida (falha
# fechado — nunca processar inline sem intenção explícita); no compose dev com
# o serviço worker-pdf, deixe false no web.
INTAKE_RUN_TASKS_INLINE=true

# Chave geral do intake (change pilot-deployment-v0-1-1, slice 002) — liga/
# desliga a criação de novos casos/reenvios (guard no boundary do serviço +
# mensagem nas rotas de POST; fail-closed). Base/dev/teste: default true;
# produção: default FALSE se não definida. Fase 1 do piloto: false (intake
# desligado — ativação futura junto aos workers/egress). Em dev, mantenha true
# para exercitar o fluxo de envio.
#INTAKE_ENABLED=true  # descomente apenas quando reativar o envio (default: false em prod — fase 1 do piloto desligado)

# Anonimização Presidio (change presidio-anonymization, slice 002) — engine
# singleton (worker/testes): modelo spaCy pt-BR carregado (default lg, ~541 MB;
# troque para pt_core_news_md em ambientes enxutos) e limiar de score do
# analyzer (default 0.45 — pesquisa §5).
ANONYMIZATION_SPACY_MODEL=pt_core_news_lg
ANONYMIZATION_SCORE_THRESHOLD=0.45

# Camada NER/Presidio da anonimização (change anonymization-deterministic-first)
# — OPT-IN, default FALSE (fase 2 determinística-first): a identidade do paciente
# é tokenizada ponta a ponta pela extração determinística (rótulos SESAB + runs
# de CPF/CNS + valores conhecidos do caso), e com o NER desligado o engine
# spaCy/Presidio nem é construído nos workers (a memória do
# worker-anonymization cai). A reativação é uma linha no .env do host
# (passthrough nos composes para worker-anonymization E worker-attachments) e
# deve ser calibrada pelo benchmark: com o NER desligado o corpus padrão falha no
# recall de CRM (a categoria é EXCLUSIVA do recognizer NER).
#ANONYMIZATION_USE_NER=true

# Processamento da anonimização (change presidio-anonymization, slice 004) —
# modo de execução da task disparada na entrada em ANONYMIZING: true (default
# dev/teste) roda a task sincronamente (sem worker, determinístico); false
# enfileira no cluster anonymization do django-q2. Produção força false se não
# definida (falha fechado — nunca rodar inline em produção sem intenção
# explícita; o processo web nunca carrega o modelo spaCy); no compose dev com o
# serviço worker-anonymization, deixe false no web e nos workers.
ANONYMIZATION_RUN_TASKS_INLINE=true

# Harness de benchmark da anonimização (change presidio-anonymization, slice
# 005) — `manage.py anonymization_benchmark --corpus <arquivo.jsonl>`: recall
# mínimo por tipo de entidade para o benchmark passar (default 0.90; o corpus
# sintético da suíte segue este valor; a aceitação com corpus real é
# operacional pré-produção) e limite duro opcional do pico de RSS do processo
# em MB (ausente/0 = desligado — o RSS é sempre reportado).
ANONYMIZATION_BENCHMARK_MIN_RECALL=0.90
#ANONYMIZATION_BENCHMARK_MAX_RSS_MB=900

# LLM OpenRouter (change llm-pipeline-per-type, slice 001) — cliente
# OpenAI-compatível da OpenRouter e comando manual `manage.py llm_check`.
# OPENROUTER_API_KEY e LLM{1,2}_MODEL têm default VAZIO: o pipeline exige as
# envs (fail-fast no uso) e o llm_check reporta a ausência. Escolha do modelo
# por benchmark operacional (llm_check), não fixada aqui.
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#LLM1_MODEL=
#LLM2_MODEL=
#LLM_TIMEOUT_SECONDS=120
# Modelo OpenAI-compatível da OpenRouter para o OCR externo de imagem/PDF-imagem
# dos anexos clínicos (change attachment-processing-ocr, slice 002): SEM default
# — vazio falha fechado no uso (o anexo vira `failed` com motivo de configuração,
# nada é enviado). Escolha por benchmark operacional, como os modelos do pipeline.
#VISION_MODEL=

# Modo de execução da task do pipeline LLM (change llm-pipeline-per-type,
# slice 006): `true` (default dev/teste) processa inline no signal de entrada;
# `false` enfileira no cluster `llm` do django-q2 (produção/compose com o
# serviço worker-llm — o processo web nunca chama a OpenRouter).
#LLM_RUN_TASKS_INLINE=false

# django-q2 (change intake-nir-upload, slice 003) — Q_CLUSTER_NAME seleciona o
# cluster alternativo executado por um processo `manage.py qcluster`: defina
# `pdf` no serviço worker-pdf, `anonymization` no serviço worker-anonymization
# e `llm` no serviço worker-llm do compose (o web e os testes não definem — o
# cluster default `hmd` da settings/base é o usado para enfileirar).
#Q_CLUSTER_NAME=pdf
#Q_CLUSTER_NAME=anonymization
#Q_CLUSTER_NAME=llm
#Q_CLUSTER_NAME=attachments

# Anexos clínicos — worker e OCR (change attachment-processing-ocr, slice 002):
# modo de execução do processamento disparado na anonimização do caso: true
# (default dev/teste) roda a task sincronamente (sem worker); false enfileira no
# cluster attachments do django-q2 (produção/compose com o serviço
# worker-attachments). Teto de páginas rasterizadas por anexo PDF-imagem para o
# OCR externo (default 10 — excedente vira `failed` com motivo claro).
#ATTACHMENTS_RUN_TASKS_INLINE=false
#ATTACHMENTS_VISION_MAX_PAGES=10

# Prior-case (change llm-pipeline-per-type, slice 005) — janelas do lookup de
# casos prévios por procedimento, em dias: match primário por número de
# ocorrência (default 7) e fallback por nome normalizado + nascimento (default
# 15; intervalo fechado — a decisão nunca é "futura" em relação ao caso atual).
PRIOR_CASE_WINDOW_DAYS=7
PRIOR_CASE_FALLBACK_WINDOW_DAYS=15

# Fase 2 — pipeline (change phase2-workers-secrets, slice 001)
# ---------------------------------------------------------------------------
# Ativação: os nomes abaixo NÃO ativam nada sozinhos — o pipeline só liga com
# INTAKE_ENABLED=true no web (abaixo) e os workers no ar
# (`docker compose -f docker-compose.prod.yml up -d --profile workers`); o
# checklist completo está no README ("Ativação da fase 2").
#
# Chave da OpenRouter SÓ por ARQUIVO, nos workers que chamam a API
# (worker-llm/worker-attachments): o compose monta o secret em
# /run/secrets/openrouter_api_key e aponta OPENROUTER_API_KEY_FILE. O arquivo
# vence a env plana OPENROUTER_API_KEY (documentada acima, para dev) e falha
# fechado se ilegível/vazio. Crie ./secrets/openrouter_api_key.txt com a chave
# em uma linha, legível pelo uid/gid 10001 (modo 0644 ou chown 10001:10001).
#OPENROUTER_API_KEY_FILE=
#
# Modelos passados adiante do .env do host (o compose usa ${VAR:-}): vazio =
# fail-fast no USO (o caso fica retido, com motivo). Confira o pipeline com o
# llm_check executado DENTRO do worker-llm; VISION_MODEL (OCR de anexos) NÃO
# tem comando de diagnóstico — confira o valor manualmente.
#LLM1_MODEL=
#LLM2_MODEL=
#VISION_MODEL=
#
# Limites de memória dos 4 workers (defaults entre parênteses; o orçamento do
# worker-anonymization cobre 2 processos do engine spaCy — calibrar pelo pico
# de RSS do `anonymization_benchmark --corpus real` × 2; se apertar, use
# ANONYMIZATION_SPACY_MODEL=pt_core_news_md).
#WORKER_PDF_MEM_LIMIT=512m
#WORKER_ANONYMIZATION_MEM_LIMIT=2560m
#WORKER_LLM_MEM_LIMIT=512m
#WORKER_ATTACHMENTS_MEM_LIMIT=512m
#
# Modelo spaCy do worker de anonimização (default lg, ~541 MB; a válvula de
# memória é o md).
#ANONYMIZATION_SPACY_MODEL=pt_core_news_lg
#
# Camada NER/Presidio (default false): reativação só com calibração prévia pelo
# `anonymization_benchmark` (o corpus padrão exige NER para o recall de CRM).
#ANONYMIZATION_USE_NER=true
#
# Chave mestra: o web segue fail-closed com o default false — só o valor
# explícito `true` libera a criação de casos/reenvios.
#INTAKE_ENABLED=true
